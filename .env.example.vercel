# ═══════════════════════════════════════════════════════════════════════════════
# 9Router on Vercel — environment variables
# ═══════════════════════════════════════════════════════════════════════════════
# Paste these into Vercel → Project → Settings → Environment Variables.
# Local-only knobs (MITM, tunnels, updater, DATA_DIR, tray) are intentionally
# absent: serverless functions have no persistent process or disk.
# Full contract: `.env.example`.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── REQUIRED ──────────────────────────────────────────────────────────────────

# Signs the session cookie. Without it serverless derives a stable secret from
# the deployment id (works, but rotating deployments log everyone out).
JWT_SECRET=change-me-to-a-long-random-secret

# Dashboard password (plain env value compared on /login). Default 123456 is
# refused for remote logins — set your own.
INITIAL_PASSWORD=change-me

# ─── PERSISTENCE (survives cold starts, shared across instances) ───────────────
# Fallback chain: KV → Upstash → Supabase → in-memory (resets on every cold start).
# Set at least one, otherwise the dashboard reverts to defaults regularly.

# PRIMARY — Upstash Redis (free tier is enough; use the REST endpoint)
# UPSTASH_REDIS_REST_URL=https://<id>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxx

# ALTERNATIVE — Vercel KV (the storage integration injects both automatically)
# KV_REST_API_URL=https://<region>.kv.vercel-storage.com
# KV_REST_API_TOKEN=xxxxxxxx

# FALLBACK — Supabase Storage blob. The service-role key is required to write;
# the anon key alone is read-only, so settings never persist with it.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_ANON_KEY=eyJ...
# NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# DIKA_SUPABASE_BUCKET=9router

# ─── API KEYS ─────────────────────────────────────────────────────────────────

# Secret for keys created from the dashboard. Setting it also makes the value
# usable as a client key.
API_KEY_SECRET=endpoint-proxy-api-key-secret

# Stable client keys (comma / space / newline separated) that survive cold
# starts — the only way to pin a key that is not stored in KV.
# API_KEYS=sk-key1,sk-key2

# Salt mixed into the derived machine id (src/shared/utils/machineId.js). Leave
# empty unless you rotate machine-bound credentials on purpose — changing it
# invalidates every derived id, so previously issued keys stop matching.
# MACHINE_ID_SALT=

# NOTE: the /v1 API-key gate is FORCED ON for Vercel deployments (an open relay
# on a public URL gets abused). REQUIRE_API_KEY is ignored here — see
# src/lib/db/adapters/vercelAdapter.js.

# ─── SELF URL / CLOUD ─────────────────────────────────────────────────────────

# Your deployment URL (used for CLI hints, OIDC/SAML redirects, self-calls).
NEXT_PUBLIC_BASE_URL=https://<project>.vercel.app
BASE_URL=https://<project>.vercel.app
# CLOUD_URL=https://9router.com
# NEXT_PUBLIC_CLOUD_URL=https://9router.com

# ─── CORS / BROWSER ───────────────────────────────────────────────────────────
# Already handled by vercel.json headers (Access-Control-* for /v1 and /api/v1).

# ─── TOGGLES & LIMITS (optional) ──────────────────────────────────────────────

# Store request/response payloads in the DB (opt-in; costs KV/Upstash writes)
# ENABLE_REQUEST_LOGS=true
# In-app observability buffer; only "false" disables it
# OBSERVABILITY_ENABLED=false
# OBSERVABILITY_MAX_RECORDS=200
# OBSERVABILITY_BATCH_SIZE=20
# OBSERVABILITY_FLUSH_INTERVAL_MS=5000
# OBSERVABILITY_MAX_JSON_SIZE=5

# Request body limit for the Next proxy (base64 images / long context)
# NINEROUTER_PROXY_CLIENT_MAX_BODY_SIZE=128mb

# Stream timeouts (ms)
# STREAM_STALL_TIMEOUT_MS=360000
# STREAM_FIRST_CHUNK_TIMEOUT_MS=200000
# FETCH_CONNECT_TIMEOUT_MS=60000

# LEVEL: debug | info | warn | error (default: info)
# LOG_LEVEL=info
# Set to 1 for verbose per-request usage lines
# LOG_USAGE_VERBOSE=0

# Skip the daily models.dev capability sync
# MODEL_CATALOG_SYNC=off

# ─── PROVIDERS ────────────────────────────────────────────────────────────────
# Provider credentials do NOT belong in Vercel env: they are only read on a cold
# start with an empty DB and ignored afterwards.
# Add them in the 9Router DASHBOARD (Providers page) — those persist to KV/Upstash
# and are shared by every serverless instance.
