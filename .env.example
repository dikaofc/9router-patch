# ═══════════════════════════════════════════════════════════════════════════════
# 9Router environment contract
# ═══════════════════════════════════════════════════════════════════════════════
# Every variable listed here is read by the code (grep-able as process.env.*).
# Copy to `.env` and edit. Uncommented entries are the ones you normally set —
# the rest are documented defaults you only touch when tuning.
#
# Serverless (Vercel/Netlify)? Use `.env.example.vercel` instead: it drops the
# local-only knobs (MITM, tunnel, updater, Docker paths).
# ═══════════════════════════════════════════════════════════════════════════════

# ─── REQUIRED ──────────────────────────────────────────────────────────────────

# Signs the dashboard session cookie (HMAC). 32+ random chars.
# When unset, a random per-boot secret is used (every restart logs you out) and
# serverless derives a stable one from the deployment id — always set it in prod.
JWT_SECRET=change-me-to-a-long-random-secret

# Dashboard password (plain env value, compared directly on /login).
# Default when unset: 123456 — override it, remote login with the default is refused.
INITIAL_PASSWORD=change-me

# Data directory for the SQLite DB, backups and logs.
# Docker: /app/data · Termux: ~/.9router · default: ~/.9router
DATA_DIR=/var/lib/9router

# ─── SERVER ────────────────────────────────────────────────────────────────────

PORT=20128
HOSTNAME=0.0.0.0
NODE_ENV=production

# Public URL of THIS 9Router instance (used for OIDC/SAML redirects and CLI hints).
NEXT_PUBLIC_BASE_URL=http://localhost:20128
BASE_URL=http://localhost:20128

# 9Router Cloud (optional sync/backup target).
CLOUD_URL=https://9router.com
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# Reverse proxy in front of 9Router? Set to "true" so the login rate limiter
# keys on X-Forwarded-For instead of the proxy socket. Leave false when the
# client can reach 9Router directly (the header would be spoofable).
TRUST_PROXY=false

# ─── API KEYS / AUTH ───────────────────────────────────────────────────────────

# Secret used to sign API keys created from the dashboard. Setting it also makes
# the value itself usable as a client key (handy for CLI tools).
API_KEY_SECRET=endpoint-proxy-api-key-secret

# Stable extra client keys (comma / space / newline separated). Seeded on boot —
# on serverless this is the only way to keep a key that survives the next cold start.
# API_KEYS=sk-key1,sk-key2

# Force the /v1/* API-key gate on ("true") or off ("false"), overriding the
# dashboard setting. Unset = use the dashboard value (default on; always on for
# Vercel deployments, which keep their open-relay guard).
# REQUIRE_API_KEY=true

# Mark the session cookie Secure (enable when served over HTTPS).
AUTH_COOKIE_SECURE=false

# Salt mixed into the machine id (e.g. per-install machineId overrides).
MACHINE_ID_SALT=

# Protects POST /api/shutdown, which lets the dashboard stop the server.
# Auto-generated per run when unset; set it only if you manage shutdown yourself.
SHUTDOWN_SECRET=

# ─── PERSISTENCE (serverless & multi-instance) ─────────────────────────────────
# Fallback chain: KV → Upstash → Supabase → in-memory (data lost on restart).
# On Vercel/Netlify set at least one or the dashboard resets on every cold start.

# Vercel KV (project storage integration injects these automatically)
# KV_REST_API_URL=https://<region>.kv.vercel-storage.com
# KV_REST_API_TOKEN=xxxxxxxx

# Upstash Redis (free tier is enough; use the REST URL, not the TCP one)
# UPSTASH_REDIS_REST_URL=https://<id>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxx

# Supabase Storage blob (second fallback). Service-role key is required to write —
# the anon key alone is read-only and will not persist anything.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_ANON_KEY=eyJ...
# NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Bucket name for the settings blob (default: 9router)
# DIKA_SUPABASE_BUCKET=9router
# Legacy alias names accepted for the same credentials
# DIKA_SUPABASE_SERVICE_ROLE_KEY=
# DIKA_SUPABASE_SECRET_KEY=
# DIKA_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_DIKA_SUPABASE_URL=

# ─── PROVIDER CREDENTIALS ──────────────────────────────────────────────────────
# All provider keys live in the DASHBOARD (Providers page). They persist to
# KV/Upstash/Supabase and work for every client.
#
# There is deliberately NO `PROVIDER_<NAME>_API_KEY` env contract: the seeding
# path was removed (see src/lib/db/adapters/vercelAdapter.js) because it only
# fired on a cold start with an empty DB and then drifted from the dashboard
# copy. Add provider connections in the UI, not here.

# Azure OpenAI — the only provider with env fallbacks, kept for Docker/VPS
# images that configure Azure once for the whole host. Values here are used only
# when the connection itself does not carry them.
# AZURE_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_DEPLOYMENT=gpt-4o
# AZURE_API_VERSION=2024-10-21
# AZURE_ORGANIZATION=
# OPENAI_API_KEY=             # api-key fallback for an Azure connection without one

# Devin CLI integration (only if you use the Devin executor)
# CLI_DEVIN_BIN=devin
# CLI_DEVIN_AGENT_TYPE=default
# DEVIN_PERMISSION_MODE=auto
# DEVIN_MCP_SERVERS=
# DEVIN_MCP_TOOLS=
# DEVIN_MCP_RESULTS=

# ─── FEATURE TOGGLES ──────────────────────────────────────────────────────────

# Advertised in the dashboard settings payload; set "true" to report the
# translator layer as enabled.
# ENABLE_TRANSLATOR=true

# Persist request/response payloads for the Request Details tab (opt-in, wins
# over the dashboard toggle).
ENABLE_REQUEST_LOGS=false

# Daily models.dev capability sync: "off" disables it (default on).
# MODEL_CATALOG_SYNC=off

# Headroom token-saver proxy (dashboard can also manage it).
HEADROOM_URL=http://localhost:8787

# SearXNG instance for the unauthenticated web-search provider.
SEARXNG_URL=http://localhost:8888/search

# Advanced provider overrides (leave unset unless a provider asks for it)
# QODER_CONTEXT_TIER=auto      # auto | max | default

# Kiro integrity gate (open-sse/executors/kiro.js). REPAIR=false turns the whole
# gate off; the tunables below cap its private buffer and per-phase timeouts.
# KIRO_TOOL_CALL_REPAIR=true
# KIRO_TOOL_CALL_REPAIR_BUFFER_MAX_BYTES=8388608   # 8 MB private replay buffer
# KIRO_TOOL_CALL_REPAIR_TIMEOUT_MS=200000          # base timeout for both phases
# KIRO_TOOL_CALL_REPAIR_TTFT_TIMEOUT_MS=200000     # time-to-first-chunk override
# KIRO_TOOL_CALL_REPAIR_STALL_TIMEOUT_MS=200000    # inter-chunk stall override
# KIMI_OAUTH_CLIENT_ID=
# KIMI_CODING_OAUTH_CLIENT_ID=
# MIMO_PLATFORM_URL=https://platform.xiaomimimo.com
# COMMAND_CODE_API_BASE_URL=https://api.commandcode.ai
# NINE_ROUTER_API_KEY=   # key used by the CLI's xAI video command

# ─── OUTBOUND NETWORK ─────────────────────────────────────────────────────────
# Standard proxy env vars are honoured for all upstream calls.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:1080
# NO_PROXY=localhost,127.0.0.1

# 9Router-owned equivalents (take precedence; managed by the Proxy Pools page)
# NINE_ROUTER_PROXY_URL=http://127.0.0.1:7890
# NINE_ROUTER_PROXY_MANAGED=true
# NINE_ROUTER_NO_PROXY=localhost,127.0.0.1

# Max body size accepted by the Next proxy (base64 images / long context).
NINEROUTER_PROXY_CLIENT_MAX_BODY_SIZE=128mb

# ─── TIMEOUTS & RETENTION ─────────────────────────────────────────────────────

# Inter-chunk stall timeout once tokens are flowing (ms)
# STREAM_STALL_TIMEOUT_MS=360000
# Time to first chunk / prompt prefill (ms)
# STREAM_FIRST_CHUNK_TIMEOUT_MS=200000
# Upstream connect timeout (response headers) (ms)
# FETCH_CONNECT_TIMEOUT_MS=60000
# GEMINI_NATIVE_TTS_FETCH_TIMEOUT_MS=45000
# VIDEO_FETCH_TIMEOUT_MS=120000
# TRAE_STREAM_TIMEOUT_MS=300000

# Settings hot-path cache TTL (ms, min 500)
# SETTINGS_CACHE_TTL_MS=2000

# Background cleaner: set CLEANER=off to disable; interval in ms.
# CLEANER=off
# CLEANER_INTERVAL_MS=3600000
# USAGE_RETENTION_DAYS=30
# USAGE_RETENTION_MAX_ROWS=50000
# USAGE_DAILY_RETENTION_DAYS=90

# ─── OBSERVABILITY / LOGGING ──────────────────────────────────────────────────

# In-app observability buffer (Request Details / Console Log pages).
# Only OBSERVABILITY_ENABLED=false turns it off; the rest fall back to the
# dashboard values and then to these defaults.
# OBSERVABILITY_ENABLED=true
# OBSERVABILITY_BUFFER_CAP=500          # write buffer cap (min 200)
# OBSERVABILITY_MAX_RECORDS=200
# OBSERVABILITY_BATCH_SIZE=20
# OBSERVABILITY_FLUSH_INTERVAL_MS=5000
# OBSERVABILITY_MAX_JSON_SIZE=5         # KB per stored payload

# LEVEL: debug | info | warn | error (default: info)
LOG_LEVEL=info
# Set to 1 for verbose per-request usage lines (any other value = off)
LOG_USAGE_VERBOSE=0

# ─── TOKEN REFRESH SCHEDULER ──────────────────────────────────────────────────

# DISABLE_BACKGROUND_TOKEN_REFRESH=true   # stop proactive OAuth refreshes
# BG_REFRESH_DELAY_MS=30000               # base delay between refresh passes
# BG_REFRESH_GOOGLE_DELAY_MS=60000        # extra spacing for Google providers
# EAGER_PROJECT_ID_REFRESH=true           # resolve Gemini project ids up-front
# ONBOARD_MAX_ATTEMPTS=3                  # Google onboard attempt budget
# ONBOARD_RETRY_DELAY_MS=2000

# ─── LOCAL-ONLY (not for serverless) ──────────────────────────────────────────

# MITM TLS proxy
# MITM_ROUTER_BASE=http://localhost:20128
# MITM_SERVER_PATH=
# ROUTER_API_KEY=            # API key the MITM layer sends to 9Router
# DEBUG_MITM=false

# Tunnels (cloudflared quick tunnels default to http2)
# TUNNEL_WORKER_URL=
# TUNNEL_TRANSPORT_PROTOCOL=http2
# CLOUDFLARED_PROTOCOL=http2

# Desktop/launcher behaviour (set by the CLI/launcher, not by hand)
# TRAY_MODE=1        # set by `9router --tray`; read by src/lib/appUpdater.js
# NO_BROWSER=1       # never auto-open a browser (Termux, headless VPS)
# NO_TRAY=1          # never fall back to the desktop tray
# USE_SQLJS=1        # force the pure-JS SQLite driver (no native build)

# Debug switches
# CURSOR_PROTOBUF_DEBUG=false
# CURSOR_STREAM_DEBUG=false
# DEBUG_BACKGROUND_TOKEN_REFRESH=false
